class NoiseResidualPreprocessor(BasePreprocessor):
    """
    Compute a high-frequency noise residual representation from an RGB image.

    The implemented filter is effectively a Gaussian high-pass filter:

        residual = image - gaussian_blur(image)

    Output shape:
        (256, 256, 3)
    """

    def __init__(
        self,
        sigma=1.0,
        epsilon=1e-8,
    ):
        """
        Parameters
        ----------
        sigma : float
            Standard deviation of the Gaussian low-pass filter.

            Larger sigma:
              - removes more low-frequency content,
              - produces a stronger high-pass response.
        epsilon : float
            Numerical stability constant.

        normalization_preprocessor : RGBNormalizationPreprocessor
        """
        self.sigma = sigma
        self.epsilon = epsilon
        self.normalization_preprocessor = RGBNormalizationPreprocessor(epsilon=epsilon)

    def __call__(self, image_patch):
        """
        Compute the residual representation.
        """

        image = self.normalization_preprocessor(image_patch)
        lowpass = gaussian_filter(
            image,
            sigma=(self.sigma, self.sigma, 0.0),
            mode="reflect",
        )

        residual = image - lowpass

        return residual
